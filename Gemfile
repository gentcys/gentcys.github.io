source "https://rubygems.org"

# Use Jekyll 4 instead of Jekyll 3
gem "jekyll", "~> 4.3"

# Explicitly add standard libraries to avoid Ruby 3.4+ warnings
gem "csv"
gem "logger"
gem "base64"

# Add any custom plugins you want to use here (e.g., jekyll-sitemap, jekyll-feed)
group :jekyll_plugins do
  gem "jekyll-gist"
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
  gem "jekyll-include-cache"
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end

# Theme for Jekyll
gem "minimal-mistakes-jekyll"